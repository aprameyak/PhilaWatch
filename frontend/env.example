# Frontend Environment Variables
# Copy this file to .env and update the values

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_AUTH_API_URL=http://localhost:8001

# Google Maps Configuration
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Roboflow Configuration (for image detection)
REACT_APP_ROBOFLOW_PROJECT=philadelphia-crime-detection
REACT_APP_ROBOFLOW_VERSION=1
REACT_APP_ROBOFLOW_API_KEY=your_roboflow_api_key_here

# External Image URLs
REACT_APP_ONBOARDING_IMAGE_URL=https://images.unsplash.com/photo-1641956405046-5e81c5bcff14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwaGlsYWRlbHBoaWElMjBjaXR5JTIwc2t5bGluZXxlbnwxfHx8fDE3NTgzMzg4MDF8MA&ixlib=rb-4.1.0&q=80&w=1080

# Deck.gl CDN
REACT_APP_DECKGL_CDN_URL=https://unpkg.com/deck.gl@^8.9.0/dist.min.js

